---
import type { FoodItem } from "@/types";

interface Props {
  foods: FoodItem[];
}

const { foods } = Astro.props;
---

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Alimento</th>
        <th>Proteína (100g)</th>
        <th>Porção ref.</th>
        <th>Proteína/porção</th>
        <th>Estado</th>
        <th>Fonte</th>
      </tr>
    </thead>
    <tbody>
      {foods.map((food) => (
        <tr>
          <td class="food-name">{food.name}</td>
          <td class="protein-value">{food.proteinPer100g.toFixed(1).replace(".", ",")} g</td>
          <td class="serving-info">{food.servingSize} {food.servingUnit}</td>
          <td class="protein-value">
            {(food.proteinPer100g * food.servingSize / 100).toFixed(1).replace(".", ",")} g
          </td>
          <td class="food-state">{food.state}</td>
          <td class="source-info">{food.source}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
