---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ResultCard from '@/components/ResultCard.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import RelatedTools from '@/components/RelatedTools.astro';
import { calculateBMI, getBMICategory, getBMICategoryLabel, getBMILimitations } from '@/lib/calculations/bmi';
import { generateCalculatorJsonLd, generateBreadcrumbJsonLd } from '@/lib/seo';
import { formatBMI, formatNumber } from '@/lib/formatting';


const calculatorJsonLd = generateCalculatorJsonLd({
  name: 'Calculadora de IMC',
  description: 'Calcule seu Índice de Massa Corporal e entenda sua classificação segundo a OMS.',
  url: 'https://fittools.com.br/ferramentas/calculadora-imc/',
  category: 'HealthApplication',
});

const breadcrumbJsonLd = generateBreadcrumbJsonLd([
  { name: 'Início', url: 'https://fittools.com.br/' },
  { name: 'Ferramentas', url: 'https://fittools.com.br/ferramentas/' },
  { name: 'Calculadora de IMC', url: 'https://fittools.com.br/ferramentas/calculadora-imc/' },
]);
---

<MainLayout
  title="Calculadora de IMC - FitTools"
  description="Calcule seu Índice de Massa Corporal (IMC) e veja sua classificação segundo a OMS. Gratuita, sem cadastro, com explicação das limitações."
  canonical="/ferramentas/calculadora-imc/"
  jsonLd={{ '@graph': [calculatorJsonLd, breadcrumbJsonLd] }}
  currentPath="/ferramentas/calculadora-imc/"
>
  <div class="calculator-page">
    <header class="calculator-header container">
      <Breadcrumbs items={[
        { label: 'Início', href: '/' },
        { label: 'Ferramentas', href: '/ferramentas/' },
        { label: 'Calculadora de IMC' },
      ]} />

      <h1 class="calculator-title">Calculadora de IMC</h1>
      <p class="calculator-description">
        Calcule seu Índice de Massa Corporal e entenda sua classificação.
        Baseado na classificação da OMS para adultos. Inclui explicação das limitações do IMC.
      </p>
    </header>

    <div class="calculator-content container">
      <!-- Form Section -->
      <section class="calculator-form-section" aria-labelledby="form-title">
        <div class="card calculator-form-card">
          <h2 id="form-title" style="font-size: var(--text-xl); font-weight: var(--font-bold); margin-bottom: var(--space-6);">Seus dados</h2>

          <form id="bmi-form" class="calculator-form" novalidate>
            <!-- Peso -->
            <div class="form-field">
              <label for="weight" class="form-label">Peso (kg) <span aria-hidden="true">*</span></label>
              <div class="number-input-wrapper">
                <input
                  type="number"
                  id="weight"
                  name="weight"
                  class="form-input"
                  placeholder="Ex: 70"
                  step="0.1"
                  min="20"
                  max="300"
                  required
                  aria-describedby="weight-hint"
                />
                <span class="number-input-unit" aria-hidden="true">kg</span>
              </div>
              <span id="weight-hint" class="form-hint">Seu peso atual em quilogramas</span>
              <span id="weight-error" class="form-error" aria-live="polite"></span>
            </div>

            <!-- Altura -->
            <div class="form-field">
              <label for="height" class="form-label">Altura (cm) <span aria-hidden="true">*</span></label>
              <div class="number-input-wrapper">
                <input
                  type="number"
                  id="height"
                  name="height"
                  class="form-input"
                  placeholder="Ex: 175"
                  step="0.1"
                  min="100"
                  max="250"
                  required
                  aria-describedby="height-hint"
                />
                <span class="number-input-unit" aria-hidden="true">cm</span>
              </div>
              <span id="height-hint" class="form-hint">Sua altura em centímetros</span>
              <span id="height-error" class="form-error" aria-live="polite"></span>
            </div>

            <!-- Ações -->
            <div class="calculator-form-actions">
              <button type="submit" class="btn btn-primary btn-lg" id="calculate-btn">
                Calcular IMC
              </button>
              <button type="button" class="btn btn-secondary btn-lg" id="clear-btn">
                Limpar
              </button>
            </div>
          </form>
        </div>
      </section>

      <!-- Results Section -->
      <section class="calculator-results-section" aria-labelledby="results-title" aria-live="polite">
        <div class="card calculator-form-card" id="results-container" style="display: none;">
          <h2 id="results-title" style="font-size: var(--text-xl); font-weight: var(--font-bold); margin-bottom: var(--space-6);">Resultado</h2>

          <div id="result-card-container">
            <!-- ResultCard será inserido aqui via JS -->
          </div>

          <!-- Escala visual do IMC -->
          <div id="bmi-scale" class="bmi-scale" role="img" aria-label="Escala visual do IMC"></div>

          <div class="calculator-form-actions" style="margin-top: var(--space-6);">
            <button type="button" class="btn btn-outline share-btn" id="share-btn" aria-label="Compartilhar resultado">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3" />
                <circle cx="6" cy="12" r="3" />
                <circle cx="18" cy="19" r="3" />
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
              </svg>
              Compartilhar
            </button>
            <button type="button" class="btn btn-secondary" id="print-btn" aria-label="Imprimir resultado">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 6 2 18 2 18 9" />
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                <rect x="6" y="14" width="12" height="8" />
              </svg>
              Imprimir
            </button>
          </div>
        </div>

        <!-- Estado vazio -->
        <div id="empty-state" class="card calculator-form-card" style="text-align: center; padding: var(--space-12);">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto var(--space-4); color: var(--color-text-muted);" aria-hidden="true">
            <path d="M12 3v18" />
            <path d="M3 12h18" />
            <path d="M12 3a6 6 0 0 0 0 12" />
            <path d="M12 3a6 6 0 0 1 0 12" />
          </svg>
          <h3 style="font-size: var(--text-xl); font-weight: var(--font-semibold); margin-bottom: var(--space-2);">Preencha o formulário</h3>
          <p style="color: var(--color-text-secondary);">Insira seu peso e altura para calcular seu IMC.</p>
        </div>
      </section>
    </div>

    <!-- Metodologia -->
    <section class="methodology container" aria-labelledby="methodology-title">
      <h2 id="methodology-title" class="methodology-title">Como funciona</h2>

      <div class="methodology-grid">
        <article class="methodology-card">
          <h3 class="methodology-card-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18"/><path d="M3 12h18"/></svg>
            Fórmula do IMC
          </h3>
          <div class="methodology-card-content">
            <p><strong>IMC = peso / (altura em metros)²</strong></p>
            <p style="margin-top: var(--space-2);">Exemplo: 70 kg / (1,75 m)² = 22,9 kg/m²</p>
          </div>
        </article>

        <article class="methodology-card">
          <h3 class="methodology-card-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            Classificação OMS (Adultos)
          </h3>
          <div class="methodology-card-content">
            <ul style="list-style: none; display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-sm);">
              <li style="display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2); background-color: #dbeafe; border-radius: var(--radius-md); color: #1e40af;"><strong>Baixo peso:</strong> < 18,5</li>
              <li style="display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2); background-color: #dcfce7; border-radius: var(--radius-md); color: #166534;"><strong>Peso normal:</strong> 18,5–24,9</li>
              <li style="display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2); background-color: #fef3c7; border-radius: var(--radius-md); color: #92400e;"><strong>Sobrepeso:</strong> 25,0–29,9</li>
              <li style="display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2); background-color: #fee2e2; border-radius: var(--radius-md); color: #991b1b;"><strong>Obesidade:</strong> ≥ 30,0</li>
            </ul>
          </div>
        </article>

        <article class="methodology-card">
          <h3 class="methodology-card-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg>
            Limitações importantes
          </h3>
          <div class="methodology-card-content">
            <p>O IMC <strong>não distingue massa muscular de gordura</strong>. Atletas podem ser classificados como "sobrepeso" ou "obesidade" apesar de saudáveis.</p>
            <ul style="list-style: disc; margin-left: var(--space-6); margin-top: var(--space-2); font-size: var(--text-sm); color: var(--color-text-secondary);">
              <li>Não se aplica a crianças/adolescentes (usar curvas de crescimento)</li>
              <li>Idosos podem ter composição corporal diferente</li>
              <li>Gestantes não devem usar esta classificação</li>
              <li>Não avalia distribuição de gordura (visceral vs subcutânea)</li>
            </ul>
          </div>
        </article>

        <article class="methodology-card">
          <h3 class="methodology-card-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            Privacidade
          </h3>
          <div class="methodology-card-content">
            <p>Cálculos rodam <strong>100% no seu navegador</strong>. Nenhum dado é enviado a servidores.</p>
            <p style="margin-top: var(--space-2);">Veja nossa <a href="/privacidade/" style="font-weight: var(--font-medium);">Política de Privacidade</a>.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq container" aria-labelledby="faq-title">
      <h2 id="faq-title" class="faq-title">Perguntas frequentes</h2>

      <div class="accordion">
        <details class="accordion-item">
          <summary class="accordion-trigger" aria-expanded="false">
            O IMC serve para crianças?
            <svg class="accordion-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </summary>
          <div class="accordion-content">
            <p><strong>Não.</strong> Para crianças e adolescentes, deve-se usar as curvas de crescimento da OMS ou do Ministério da Saúde (percentis de IMC por idade e sexo). Esta calculadora usa a classificação para adultos.</p>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-trigger" aria-expanded="false">
            Sou atleta e meu IMC deu "sobrepeso". O que faço?
            <svg class="accordion-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </summary>
          <div class="accordion-content">
            <p>Isso é comum. O IMC não distingue massa muscular de gordura. Atletas de força, lutadores, corredores de velocidade e fisiculturistas frequentemente têm IMC > 25 com baixo percentual de gordura. Use outros métodos: dobras cutâneas, bioimpedância, DEXA ou circunferência abdominal.</p>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-trigger" aria-expanded="false">
            IMC normal significa que estou saudável?
            <svg class="accordion-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </summary>
          <div class="accordion-content">
            <p><strong>Não necessariamente.</strong> Uma pessoa pode ter IMC normal mas alto percentual de gordura (chamado "obesidade de peso normal" ou sarcopenia). Saúde depende de composição corporal, alimentação, atividade, sono, estresse, exames laboratoriais, etc.</p>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-trigger" aria-expanded="false">
            Qual a diferença entre sobrepeso e obesidade?
            <svg class="accordion-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </summary>
          <div class="accordion-content">
            <p>Segundo a OMS: <strong>Sobrepeso</strong> = IMC 25,0–29,9; <strong>Obesidade</strong> = IMC ≥ 30,0. A obesidade é subdividida em: Grau I (30–34,9), Grau II (35–39,9), Grau III (≥ 40). Quanto maior o grau, maior o risco cardiometabólico.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- Disclaimer -->
    <Disclaimer type="medical" />

    <!-- Related Tools -->
    <RelatedTools toolIds={['protein-calculator', 'calorie-calculator']} title="Outras calculadoras úteis" />
  </div>

  <script>
    // Client-side BMI calculator logic
    (function() {
      'use strict';

      const form = document.getElementById('bmi-form');
      const calculateBtn = document.getElementById('calculate-btn');
      const clearBtn = document.getElementById('clear-btn');
      const shareBtn = document.getElementById('share-btn');
      const printBtn = document.getElementById('print-btn');
      const resultsContainer = document.getElementById('results-container');
      const resultCardContainer = document.getElementById('result-card-container');
      const emptyState = document.getElementById('empty-state');
      const bmiScale = document.getElementById('bmi-scale');

      let lastResult = null;

      function validateField(name, value) {
        const errors = {};

        if (name === 'weight') {
          const num = parseFloat(value);
          if (isNaN(num) || value === '') errors.weight = 'Peso é obrigatório';
          else if (num < 20 || num > 300) errors.weight = 'Peso deve estar entre 20 e 300 kg';
        }

        if (name === 'height') {
          const num = parseFloat(value);
          if (isNaN(num) || value === '') errors.height = 'Altura é obrigatória';
          else if (num < 100 || num > 250) errors.height = 'Altura deve estar entre 100 e 250 cm';
        }

        return errors;
      }

      function showError(fieldName, message) {
        const errorEl = document.getElementById(`${fieldName}-error`);
        const inputEl = document.getElementById(fieldName);
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.style.display = 'block';
        }
        if (inputEl) {
          inputEl.setAttribute('aria-invalid', 'true');
        }
      }

      function clearError(fieldName) {
        const errorEl = document.getElementById(`${fieldName}-error`);
        const inputEl = document.getElementById(fieldName);
        if (errorEl) {
          errorEl.textContent = '';
          errorEl.style.display = 'none';
        }
        if (inputEl) {
          inputEl.removeAttribute('aria-invalid');
        }
      }

      function clearAllErrors() {
        ['weight', 'height'].forEach(clearError);
      }

      function formatNumber(num, decimals = 0) {
        return new Intl.NumberFormat('pt-BR', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        }).format(num);
      }

      function calculateBMI(weight, heightCm) {
        const heightM = heightCm / 100;
        const bmi = weight / (heightM * heightM);
        return Math.round(bmi * 10) / 10;
      }

      function getCategory(bmi) {
        if (bmi < 18.5) return 'underweight';
        if (bmi < 25) return 'normal';
        if (bmi < 30) return 'overweight';
        return 'obesity';
      }

      function getCategoryLabel(category) {
        const labels = {
          underweight: 'Baixo peso',
          normal: 'Peso normal',
          overweight: 'Sobrepeso',
          obesity: 'Obesidade',
        };
        return labels[category] || category;
      }

      function renderScale(bmi, category) {
        const categories = [
          { key: 'underweight', label: 'Baixo peso', range: '< 18,5', color: '#dbeafe', textColor: '#1e40af' },
          { key: 'normal', label: 'Peso normal', range: '18,5–24,9', color: '#dcfce7', textColor: '#166534' },
          { key: 'overweight', label: 'Sobrepeso', range: '25,0–29,9', color: '#fef3c7', textColor: '#92400e' },
          { key: 'obesity', label: 'Obesidade', range: '≥ 30,0', color: '#fee2e2', textColor: '#991b1b' },
        ];

        bmiScale.innerHTML = categories.map(cat => `
          <div class="bmi-scale-item ${cat.key} ${cat.key === category ? 'active' : ''}" style="background-color: ${cat.color}; color: ${cat.textColor};" role="listitem" aria-label="${cat.label}: ${cat.range}${cat.key === category ? ' (seu resultado)' : ''}">
            <div class="bmi-scale-label">${cat.label}</div>
            <div class="bmi-scale-range">${cat.range}</div>
          </div>
        `).join('');
      }

      function renderResult(result) {
        resultCardContainer.innerHTML = `
          <div class="result-main">
            <div class="result-value">${formatNumber(result.bmi, 1)}</div>
            <span class="result-unit">kg/m²</span>
            <div class="result-range">
              <div class="result-range-item">
                <span class="result-range-label">Classificação</span>
                <span class="result-range-value">${result.categoryLabel}</span>
              </div>
            </div>
          </div>

          <div class="result-details">
            <div class="result-detail">
              <span class="result-detail-label">Peso</span>
              <span class="result-detail-value">${formatNumber(result.weight, 1)} kg</span>
            </div>
            <div class="result-detail">
              <span class="result-detail-label">Altura</span>
              <span class="result-detail-value">${formatNumber(result.height / 100, 2)} m</span>
            </div>
          </div>
        `;

        renderScale(result.bmi, result.category);
      }

      function showResults() {
        emptyState.style.display = 'none';
        resultsContainer.style.display = 'block';
        resultsContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function clearForm() {
        form.reset();
        clearAllErrors();
        emptyState.style.display = 'block';
        resultsContainer.style.display = 'none';
        bmiScale.innerHTML = '';
        lastResult = null;
      }

      async function shareResult() {
        if (!lastResult) return;

        const text = `Meu IMC: ${formatNumber(lastResult.bmi, 1)} kg/m² (${lastResult.categoryLabel}). Calculado no FitTools: https://fittools.com.br/ferramentas/calculadora-imc/`;

        if (navigator.share) {
          try {
            await navigator.share({
              title: 'Meu IMC - FitTools',
              text: text,
              url: window.location.href,
            });
          } catch (e) {}
        } else {
          try {
            await navigator.clipboard.writeText(text);
            shareBtn.textContent = 'Copiado!';
            setTimeout(() => { shareBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg> Compartilhar'; }, 2000);
          } catch (e) {}
        }
      }

      function printResult() {
        window.print();
      }

      // Calculate
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const weight = parseFloat(formData.get('weight'));
        const height = parseFloat(formData.get('height'));

        // Validate
        clearAllErrors();
        let hasErrors = false;

        if (isNaN(weight) || weight === '') {
          showError('weight', 'Peso é obrigatório');
          hasErrors = true;
        } else if (weight < 20 || weight > 300) {
          showError('weight', 'Peso deve estar entre 20 e 300 kg');
          hasErrors = true;
        }

        if (isNaN(height) || height === '') {
          showError('height', 'Altura é obrigatória');
          hasErrors = true;
        } else if (height < 100 || height > 250) {
          showError('height', 'Altura deve estar entre 100 e 250 cm');
          hasErrors = true;
        }

        if (hasErrors) {
          const firstError = form.querySelector('[aria-invalid="true"]');
          firstError?.focus();
          return;
        }

        // Calculate
        const bmi = calculateBMI(weight, height);
        const category = getCategory(bmi);
        const categoryLabel = getCategoryLabel(category);

        lastResult = { bmi, category, categoryLabel, weight, height };
        renderResult(lastResult);
        showResults();
      });

      clearBtn.addEventListener('click', clearForm);
      shareBtn.addEventListener('click', shareResult);
      printBtn.addEventListener('click', printResult);

      // Clear error on input
      form.querySelectorAll('input').forEach(el => {
        el.addEventListener('input', () => clearError(el.id));
        el.addEventListener('change', () => clearError(el.id));
      });

      // Real-time validation on blur
      form.querySelectorAll('input[required]').forEach(el => {
        el.addEventListener('blur', () => {
          const errors = validateField(el.name, el.value);
          if (errors[el.name]) {
            showError(el.name, errors[el.name]);
          } else {
            clearError(el.name);
          }
        });
      });
    })();
  </script>
</MainLayout>
