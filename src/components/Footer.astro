---
import { footerNavigation, socialLinks } from '@/data/navigation';
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="FitTools - Início">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2L2 7l10 5 10-5-10-5z" />
            <path d="M2 17l10 5 10-5" />
            <path d="M2 12l10 5 10-5" />
          </svg>
          <span>FitTools</span>
        </a>
        <p class="footer-description">
          Ferramentas gratuitas para calcular, entender e melhorar sua rotina fitness.
          Baseado em ciência, sem cadastro, com privacidade.
        </p>
        <div class="footer-social">
          <a
            href={socialLinks.instagram}
            class="footer-social-link"
            aria-label="Instagram do FitTools"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            href={socialLinks.youtube}
            class="footer-social-link"
            aria-label="YouTube do FitTools"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.44 24.1 24.1 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.44 24.1 24.1 0 0 1-16.2 0A2 2 0 0 1 2.5 17" />
              <path d="M10 10l5 3-5 3z" />
            </svg>
          </a>
        </div>
      </div>

      <nav aria-label="Institucional">
        <h3 class="footer-title">Institucional</h3>
        <ul class="footer-links">
          {footerNavigation.institucional.map((item) => (
            <li>
              <a href={item.href} class="footer-link" {item.external && 'target="_blank" rel="noopener noreferrer"'}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Ferramentas">
        <h3 class="footer-title">Ferramentas</h3>
        <ul class="footer-links">
          {footerNavigation.ferramentas.map((item) => (
            <li>
              <a href={item.href} class="footer-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Redes sociais">
        <h3 class="footer-title">Redes sociais</h3>
        <ul class="footer-links">
          {footerNavigation.social.map((item) => (
            <li>
              <a href={item.href} class="footer-link" target="_blank" rel="noopener noreferrer">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} FitTools. Todos os direitos reservados. Feito por Lin Tech
        <br />
        Ferramentas educativas - não substituem orientação profissional.
      </p>
    </div>
  </div>
</footer>
