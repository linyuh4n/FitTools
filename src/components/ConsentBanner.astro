---
/**
 * LGPD Consent Banner
 * Gerencia consentimento para cookies de analytics e ads (GA4, AdSense)
 * Conforme LGPD Art. 7º e 8º - consentimento livre, informado e inequívoco
 */
import { SITE_URL } from 'astro:env/client';

const ga4Id = import.meta.env.GA4_MEASUREMENT_ID;
const adsenseId = import.meta.env.ADSENSE_CLIENT_ID;

const hasAnalytics = ga4Id && ga4Id !== '';
const hasAds = adsenseId && adsenseId !== '';
const shouldShowBanner = hasAnalytics || hasAds;
---

<script is:inline>
  // Consent management - runs immediately on page load
  (function() {
    const CONSENT_KEY = 'fittools_consent';
    const CONSENT_VERSION = '1';

    function getConsent() {
      try {
        const stored = localStorage.getItem(CONSENT_KEY);
        if (!stored) return null;
        const parsed = JSON.parse(stored);
        if (parsed.version !== CONSENT_VERSION) return null;
        return parsed;
      } catch {
        return null;
      }
    }

    function setConsent(analytics, ads) {
      const consent = {
        version: CONSENT_VERSION,
        timestamp: new Date().toISOString(),
        analytics: !!analytics,
        ads: !!ads,
        necessary: true
      };
      localStorage.setItem(CONSENT_KEY, JSON.stringify(consent));
      return consent;
    }

    function loadGa4(id) {
      if (!id) return;
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      gtag('config', id, { anonymize_ip: true });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
      document.head.appendChild(script);
    }

    function loadAdsense(id) {
      if (!id) return;
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${id}`;
      script.crossOrigin = 'anonymous';
      document.head.appendChild(script);
      
      window.adsbygoogle = window.adsbygoogle || [];
      window.adsbygoogle.push({});
    }

    function applyConsent(consent) {
      if (!consent) return;
      
      if (consent.analytics && hasAnalytics) {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
      if (consent.ads && hasAds) {
        gtag('consent', 'update', { 
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted'
        });
        // Re-trigger adsense if not loaded
        if (window.adsbygoogle) {
          window.adsbygoogle.push({});
        }
      }
    }

    // Initialize on DOM ready
    function init() {
      const consent = getConsent();
      
      if (consent) {
        // Apply existing consent
        applyConsent(consent);
      } else {
        // Show banner if analytics or ads are configured
        if (shouldShowBanner) {
          showBanner();
        }
      }
    }

    function showBanner() {
      const banner = document.getElementById('consent-banner');
      if (banner) {
        banner.hidden = false;
        banner.style.display = 'block';
        // Focus first button for accessibility
        const acceptBtn = banner.querySelector('[data-consent="accept-all"]');
        if (acceptBtn) acceptBtn.focus();
      }
    }

    function hideBanner() {
      const banner = document.getElementById('consent-banner');
      if (banner) {
        banner.hidden = true;
        banner.style.display = 'none';
      }
    }

    // Expose functions globally for inline handlers
    window.fittoolsConsent = {
      acceptAll: function() {
        const consent = setConsent(true, true);
        applyConsent(consent);
        hideBanner();
      },
      acceptAnalytics: function() {
        const consent = setConsent(true, false);
        applyConsent(consent);
        hideBanner();
      },
      rejectAll: function() {
        const consent = setConsent(false, false);
        applyConsent(consent);
        hideBanner();
      },
      showSettings: function() {
        const modal = document.getElementById('consent-modal');
        if (modal) {
          modal.hidden = false;
          modal.style.display = 'flex';
          const saveBtn = modal.querySelector('[data-consent="save"]');
          if (saveBtn) saveBtn.focus();
        }
      },
      saveSettings: function() {
        const modal = document.getElementById('consent-modal');
        const analytics = modal?.querySelector('[data-consent-toggle="analytics"]')?.checked ?? false;
        const ads = modal?.querySelector('[data-consent-toggle="ads"]')?.checked ?? false;
        const consent = setConsent(analytics, ads);
        applyConsent(consent);
        if (modal) {
          modal.hidden = true;
          modal.style.display = 'none';
        }
        hideBanner();
      },
      closeModal: function() {
        const modal = document.getElementById('consent-modal');
        if (modal) {
          modal.hidden = true;
          modal.style.display = 'none';
        }
      }
    };

    // Initialize consent state on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Re-apply consent on navigation (Astro view transitions)
    document.addEventListener('astro:after-swap', function() {
      const consent = getConsent();
      if (consent) applyConsent(consent);
    });
  })();
</script>

<!-- Consent Banner -->
{shouldShowBanner && (
  <div 
    id="consent-banner" 
    role="dialog" 
    aria-labelledby="consent-title" 
    aria-describedby="consent-description"
    hidden
    style="display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999; background: var(--color-bg); border-top: 1px solid var(--color-border); box-shadow: var(--shadow-xl); padding: var(--space-4) var(--space-6);"
  >
    <div class="container" style="max-width: var(--container-max); margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-4);">
      <div style="display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: flex-start; justify-content: space-between;">
        <div style="flex: 1; min-width: 280px;">
          <h3 id="consent-title" style="font-size: var(--text-lg); font-weight: var(--font-semibold); margin-bottom: var(--space-1);">Privacidade e cookies</h3>
          <p id="consent-description" style="font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.6; margin: 0;">
            Utilizamos cookies essenciais para o funcionamento do site e, com seu consentimento, cookies de 
            {hasAnalytics && hasAds ? 'analytics e anúncios personalizados' : hasAnalytics ? 'analytics' : 'anúncios personalizados'}
            para melhorar sua experiência. 
            <a href="/privacidade/" style="color: var(--color-primary); text-decoration: underline;">Saiba mais</a>.
          </p>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center;">
          <button 
            type="button" 
            data-consent="accept-all"
            class="btn btn-primary"
            style="white-space: nowrap;"
            aria-label="Aceitar todos os cookies"
          >
            Aceitar todos
          </button>
          <button 
            type="button" 
            data-consent="accept-analytics"
            class="btn btn-secondary"
            style="white-space: nowrap;"
            aria-label="Aceitar apenas cookies essenciais e de analytics"
          >
            {hasAnalytics ? 'Apenas analytics' : 'Aceitar essenciais'}
          </button>
          <button 
            type="button" 
            data-consent="reject-all"
            class="btn btn-outline"
            style="white-space: nowrap;"
            aria-label="Rejeitar cookies não essenciais"
          >
            Rejeitar
          </button>
          <button 
            type="button" 
            onclick="fittoolsConsent.showSettings()"
            class="btn btn-sm"
            style="white-space: nowrap; background: transparent; border: none; color: var(--color-text-secondary); padding: var(--space-2);"
            aria-label="Configurar preferências de cookies"
          >
            Preferências
          </button>
        </div>
      </div>
    </div>
  </div>
)}

<!-- Consent Modal (Settings) -->
{shouldShowBanner && (
  <div 
    id="consent-modal" 
    role="dialog" 
    aria-labelledby="consent-modal-title" 
    aria-modal="true"
    hidden
    style="display: none; position: fixed; inset: 0; z-index: 10000; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; padding: var(--space-4);"
  >
    <div 
      style="background: var(--color-bg); border-radius: var(--radius-lg); max-width: 480px; width: 100%; max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-xl);"
    >
      <div style="padding: var(--space-6); border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
        <h2 id="consent-modal-title" style="font-size: var(--text-xl); font-weight: var(--font-bold); margin: 0;">Preferências de privacidade</h2>
        <button 
          type="button" 
          onclick="fittoolsConsent.closeModal()"
          aria-label="Fechar janela de preferências"
          style="background: none; border: none; font-size: var(--text-2xl); line-height: 1; cursor: pointer; color: var(--color-text-muted); padding: 0;"
        >
          ×
        </button>
      </div>
      <div style="padding: var(--space-6);">
        <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-6); line-height: 1.6;">
          Gerencie suas preferências de cookies. Cookies essenciais não podem ser desativados pois são necessários para o funcionamento do site.
        </p>
        
        <fieldset style="border: none; margin: 0; padding: 0;">
          <legend style="font-weight: var(--font-semibold); margin-bottom: var(--space-4); font-size: var(--text-base);">Cookies essenciais</legend>
          <label style="display: flex; align-items: center; gap: var(--space-3); cursor: default; padding: var(--space-3); background: var(--color-bg-secondary); border-radius: var(--radius-md);">
            <input type="checkbox" checked disabled style="width: 18px; height: 18px; accent-color: var(--color-primary);" />
            <span style="font-size: var(--text-sm);">Necessários para funcionamento, segurança e acessibilidade</span>
          </label>
        </fieldset>

        {hasAnalytics && (
          <fieldset style="border: none; margin: var(--space-6) 0 0; padding: 0;">
            <legend style="font-weight: var(--font-semibold); margin-bottom: var(--space-4); font-size: var(--text-base);">Analytics</legend>
            <label style="display: flex; align-items: center; gap: var(--space-3); cursor: pointer; padding: var(--space-3); background: var(--color-bg-secondary); border-radius: var(--radius-md); transition: background var(--transition-fast);"
              onmouseover="this.style.background='var(--color-bg-tertiary)'" 
              onmouseout="this.style.background='var(--color-bg-secondary)'"
            >
              <input 
                type="checkbox" 
                data-consent-toggle="analytics" 
                style="width: 18px; height: 18px; accent-color: var(--color-primary);" 
              />
              <div>
                <div style="font-weight: var(--font-medium); font-size: var(--text-sm);">Google Analytics (GA4)</div>
                <div style="font-size: var(--text-xs); color: var(--color-text-muted);">Coleta dados anônimos de navegação para melhorar o site. IP anonimizado.</div>
              </div>
            </label>
          </fieldset>
        )}

        {hasAds && (
          <fieldset style="border: none; margin: var(--space-6) 0 0; padding: 0;">
            <legend style="font-weight: var(--font-semibold); margin-bottom: var(--space-4); font-size: var(--text-base);">Anúncios personalizados</legend>
            <label style="display: flex; align-items: center; gap: var(--space-3); cursor: pointer; padding: var(--space-3); background: var(--color-bg-secondary); border-radius: var(--radius-md); transition: background var(--transition-fast);"
              onmouseover="this.style.background='var(--color-bg-tertiary)'" 
              onmouseout="this.style.background='var(--color-bg-secondary)'"
            >
              <input 
                type="checkbox" 
                data-consent-toggle="ads" 
                style="width: 18px; height: 18px; accent-color: var(--color-primary);" 
              />
              <div>
                <div style="font-weight: var(--font-medium); font-size: var(--text-sm);">Google AdSense</div>
                <div style="font-size: var(--text-xs); color: var(--color-text-muted);">Exibe anúncios personalizados baseados em seus interesses e navegação.</div>
              </div>
            </label>
          </fieldset>
        )}

        <div style="margin-top: var(--space-6); display: flex; gap: var(--space-3); justify-content: flex-end;">
          <button 
            type="button" 
            onclick="fittoolsConsent.closeModal()"
            class="btn btn-secondary"
            aria-label="Cancelar e manter configurações atuais"
          >
            Cancelar
          </button>
          <button 
            type="button" 
            data-consent="save"
            onclick="fittoolsConsent.saveSettings()"
            class="btn btn-primary"
            aria-label="Salvar preferências selecionadas"
          >
            Salvar preferências
          </button>
        </div>
      </div>
    </div>
  </div>
)}
