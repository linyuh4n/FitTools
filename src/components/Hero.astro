---
interface Props {
  title?: string;
  subtitle?: string;
  primaryCta?: { text: string; href: string };
  secondaryCta?: { text: string; href: string };
}

const {
  title = 'Cuide da sua evolução com inteligência.',
  subtitle = 'Calculadoras e ferramentas gratuitas para ajudar você a entender sua alimentação, treinamento e evolução física.',
  primaryCta = { text: 'Explorar ferramentas', href: '/ferramentas/' },
  secondaryCta = { text: 'Calcular minha proteína', href: '/ferramentas/calculadora-proteina/' },
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-content">
    <h1 id="hero-title" class="hero-title">{title}</h1>
    <p class="hero-subtitle">{subtitle}</p>
    <div class="hero-actions">
      <a href={primaryCta.href} class="btn btn-primary btn-lg">
        {primaryCta.text}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
      <a href={secondaryCta.href} class="btn btn-outline btn-lg">
        {secondaryCta.text}
      </a>
    </div>
  </div>
</section>
