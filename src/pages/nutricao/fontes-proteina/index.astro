---
import MainLayout from "@/layouts/MainLayout.astro";
import { generateArticleJsonLd } from "@/lib/seo";
import { foodDatabase, getFoodsByDietPreference, getFoodsByCategory, getTopProteinFoods } from "@/data/foods";
import FoodTable from "@/components/FoodTable.astro";
import "@/styles/components.css";

const title = "Fontes de Proteína: Guia Completo com Tabela Nutricional";
const description = "Tabela completa de alimentos ricos em proteína baseada na TACO/IBGE. Valores por 100g e por porção, separados por categoria e dieta (onívora, vegetariana, vegana).";
const canonical = "/nutricao/fontes-proteina/";

const jsonLd = generateArticleJsonLd({
  title,
  description,
  url: "https://fittools.com.br/nutricao/fontes-proteina/",
  image: "https://fittools.com.br/social/og-default.svg",
  datePublished: "2024-01-15T00:00:00-03:00",
  dateModified: new Date().toISOString(),
  authorName: "FitTools",
  publisherName: "FitTools",
});

const categories = [...new Set(foodDatabase.map(f => f.category))].sort();
const diets = [
  { key: "omnivore", label: "Onívora", description: "Todos os alimentos" },
  { key: "vegetarian", label: "Vegetariana", description: "Com ovos e laticínios" },
  { key: "vegan", label: "Vegana", description: "Apenas vegetais" },
] as const;
---

<MainLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} currentPath="/nutricao/fontes-proteina/">
  <article class="article-page">
    <header class="article-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="Navegação">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <a href="/nutricao/">Nutrição</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Fontes de Proteína</span>
        </nav>
        <h1>{title}</h1>
        <p class="article-lead">{description}</p>
        <div class="article-meta">
          <time datetime="2024-01-15">15 de janeiro de 2024</time>
          <span>Atualizado em {new Date().toLocaleDateString("pt-BR", { day: "numeric", month: "long", year: "numeric" })}</span>
        </div>
      </div>
    </header>

    <div class="container article-content">
      <section class="article-section" aria-labelledby="intro">
        <h2 id="intro">Sobre esta tabela</h2>
        <p>Esta tabela reúne os valores de proteína dos principais alimentos consumidos no Brasil, baseada na <strong>Tabela Brasileira de Composição de Alimentos (TACO)</strong> 4ª edição e na <strong>Tabela Brasileira de Composição de Alimentos (TBCA)</strong> da USP.</p>
        <ul>
          <li><strong>Valores por 100g:</strong> Permite comparar a densidade proteica entre alimentos</li>
          <li><strong>Porção referência:</strong> Tamanho típico de consumo para contextualizar</li>
          <li><strong>Estado do alimento:</strong> Cru, cozido, preparado ou seco (afeta o valor final)</li>
          <li><strong>Fonte:</strong> Cada item cita a referência original</li>
        </ul>
        <p class="disclaimer">⚠️ <strong>Importante:</strong> Valores são médias. A composição pode variar por marca, preparo, variedade e safra. Use como referência, não como valor exato.</p>
      </section>

      <section class="article-section" aria-labelledby="diet-filter">
        <h2 id="diet-filter">Filtrar por preferência alimentar</h2>
        <div class="diet-tabs" role="tablist" aria-label="Preferência alimentar">
          {diets.map((diet) => (
            <button
              role="tab"
              aria-selected={diet.key === "omnivore"}
              aria-controls={"panel-" + diet.key}
              id={"tab-" + diet.key}
              data-diet={diet.key}
              class="diet-tab"
            >
              {diet.label}
              <span class="diet-tab-desc">{diet.description}</span>
            </button>
          ))}
        </div>

        {diets.map((diet) => {
          const foods = getFoodsByDietPreference(diet.key);
          const topFoods = getTopProteinFoods(diet.key, 10);
          return (
            <div
              role="tabpanel"
              id={"panel-" + diet.key}
              aria-labelledby={"tab-" + diet.key}
              class="diet-panel"
              hidden={diet.key !== "omnivore"}
            >
              <div class="diet-summary">
                <p><strong>{foods.length} alimentos</strong> compatíveis com dieta {diet.label.toLowerCase()}.</p>
                <p>Top 10 com maior densidade proteica (por 100g):</p>
              </div>
              <FoodTable foods={topFoods} />
            </div>
          );
        })}
      </section>

      <section class="article-section" aria-labelledby="by-category">
        <h2 id="by-category">Tabela completa por categoria</h2>
        <p>Todos os alimentos organizados por grupo. Use o filtro acima para mostrar apenas sua dieta.</p>
        
        {categories.map((category) => {
          const foods = getFoodsByCategory(category);
          return (
            <div class="category-section" id={"cat-" + category.toLowerCase().replace(/\s+/g, "-")}>
              <h3>{category}</h3>
              <FoodTable foods={foods} />
            </div>
          );
        })}
      </section>

      <section class="article-section" aria-labelledby="protein-quality">
        <h2 id="protein-quality">Qualidade da proteína: Completa vs Incompleta</h2>
        
        <h3>Proteínas completas</h3>
        <p>Contêm todos os 9 aminoácidos essenciais em proporções adequadas:</p>
        <ul>
          <li><strong>Origem animal:</strong> Carnes, peixes, ovos, laticínios</li>
          <li><strong>Origem vegetal:</strong> Soja (tofu, tempê, PTS), quinoa, chia, linhaça, amaranto, trigo sarraceno</li>
        </ul>

        <h3>Proteínas incompletas (limitadas em algum aminoácido)</h3>
        <p>A maioria das leguminosas é limitada em metionina; cereais são limitados em lisina.</p>
        <ul>
          <li><strong>Leguminosas:</strong> Feijão, lentilha, grão-de-bico, ervilha, soja em grão</li>
          <li><strong>Cereais:</strong> Arroz, trigo, milho, aveia</li>
          <li><strong>Oleaginosas/sementes:</strong> Amendoim, castanhas, gergelim</li>
        </ul>

        <h3>Combinação para perfil completo (vegetarianos/veganos)</h3>
        <p>A combinação clássica <strong>leguminosa + cereal</strong> fornece todos os aminoácidos essenciais:</p>
        <ul>
          <li>Arroz + feijão (base da alimentação brasileira)</li>
          <li>Lentilha + quinoa</li>
          <li>Grão-de-bico + trigo (pão, cuscuz, massa)</li>
          <li>Feijão + milho</li>
          <li>Soja + arroz</li>
        </ul>
        <p class="note">💡 Não precisa ser na mesma refeição. Desde que consuma variedade ao longo do dia, o corpo faz o pool de aminoácidos.</p>
      </section>

      <section class="article-section" aria-labelledby="tips">
        <h2 id="tips">Dicas práticas</h2>
        <ul>
          <li><strong>Cozimento:</strong> Leguminosas cozidas têm ~1/3 da proteína do grão seco (absorvem água)</li>
          <li><strong>Demolho:</strong> Deixar feijão/grão-de-bico de molho 8-12h reduz antinutrientes e melhora digestão</li>
          <li><strong>Tofu/Tempê:</strong> Tempê tem mais proteína e probióticos por ser fermentado</li>
          <li><strong>Iogurte grego:</strong> 2x mais proteína que iogurte natural (coado)</li>
          <li><strong>Clara de ovo:</strong> Proteína pura, sem gordura/colesterol da gema</li>
          <li><strong>PTS:</strong> Hidrate em água quente 10min, escorra e tempere; substitui carne moída</li>
        </ul>
      </section>

      <section class="article-section" aria-labelledby="references">
        <h2 id="references">Referências</h2>
        <ol class="references">
          <li>NEPA-UNICAMP. <cite>Tabela Brasileira de Composição de Alimentos (TACO)</cite>, 4ª ed. rev. e ampl. Campinas: NEPA-UNICAMP, 2011.</li>
          <li>USP/FMUSP. <cite>Tabela Brasileira de Composição de Alimentos (TBCA)</cite>. Disponível em: <a href="http://www.fcf.usp.br/tbca" target="_blank" rel="noopener">www.fcf.usp.br/tbca</a>.</li>
          <li>IBGE. <cite>Pesquisa de Orçamentos Familiares 2017-2018: Análise do Consumo Alimentar Pessoal no Brasil</cite>. Rio de Janeiro, 2020.</li>
        </ol>
      </section>

      <aside class="article-cta">
        <h2>Quer calcular sua necessidade de proteína?</h2>
        <p>Use nossa calculadora para descobrir sua faixa ideal baseada no peso, objetivo e preferência alimentar.</p>
        <a href="/ferramentas/calculadora-proteina/" class="btn btn-primary btn-lg">Calcular minha proteína</a>
      </aside>
    </div>
  </article>

  <style>
    .article-page {
      padding: var(--space-8) 0 var(--space-16);
    }

    .article-header {
      margin-bottom: var(--space-10);
      padding-bottom: var(--space-8);
      border-bottom: 1px solid var(--color-border);
    }

    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-text-secondary);
      margin-bottom: var(--space-4);
    }

    .breadcrumb a {
      color: var(--color-text-secondary);
      transition: color var(--transition-fast);
    }

    .breadcrumb a:hover {
      color: var(--color-primary);
    }

    .breadcrumb span[aria-current="page"] {
      color: var(--color-text);
      font-weight: var(--font-medium);
    }

    .article-header h1 {
      margin-bottom: var(--space-3);
      line-height: 1.15;
    }

    .article-lead {
      font-size: var(--text-lg);
      color: var(--color-text-secondary);
      max-width: 700px;
      margin-bottom: var(--space-4);
    }

    .article-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .article-content {
      max-width: 900px;
    }

    .article-section {
      margin-bottom: var(--space-16);
    }

    .article-section h2 {
      font-size: var(--text-2xl);
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-2);
      border-bottom: 2px solid var(--color-primary);
      display: inline-block;
    }

    .article-section h3 {
      font-size: var(--text-xl);
      margin: var(--space-6) 0 var(--space-3);
      color: var(--color-primary-dark);
    }

    .article-section p {
      margin-bottom: var(--space-4);
      line-height: 1.7;
    }

    .article-section ul,
    .article-section ol {
      margin-bottom: var(--space-4);
      padding-left: var(--space-6);
    }

    .article-section li {
      margin-bottom: var(--space-2);
      line-height: 1.6;
    }

    .disclaimer {
      background: var(--color-warning-light, #fffbeb);
      border: 1px solid var(--color-warning, #f59e0b);
      border-radius: var(--radius-md);
      padding: var(--space-4);
      margin: var(--space-4) 0;
    }

    .disclaimer strong {
      color: var(--color-warning-dark, #92400e);
    }

    .note {
      font-size: var(--text-sm);
      color: var(--color-primary-dark);
      background: var(--color-primary-light);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--color-primary);
      margin: var(--space-4) 0;
    }

    /* Diet tabs */
    .diet-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-6);
      border-bottom: 2px solid var(--color-border);
      padding-bottom: var(--space-2);
    }

    .diet-tab {
      padding: var(--space-3) var(--space-5);
      background: var(--color-bg-secondary);
      border: 2px solid var(--color-border);
      border-radius: var(--radius-full);
      font-size: var(--text-sm);
      font-weight: var(--font-medium);
      color: var(--color-text-secondary);
      cursor: pointer;
      transition: all var(--transition-fast);
      text-align: left;
    }

    .diet-tab:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    .diet-tab[aria-selected="true"] {
      background: var(--color-primary);
      border-color: var(--color-primary);
      color: var(--color-text-inverse);
    }

    .diet-tab[aria-selected="true"] .diet-tab-desc {
      color: rgba(255,255,255,0.8);
    }

    .diet-tab-desc {
      display: block;
      font-size: var(--text-xs);
      font-weight: var(--font-normal);
      opacity: 0.7;
      margin-top: 2px;
    }

    .diet-panel {
      animation: fadeIn 0.2s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .diet-panel[hidden] {
      display: none;
    }

    .diet-summary {
      margin-bottom: var(--space-4);
      padding: var(--space-4);
      background: var(--color-bg-secondary);
      border-radius: var(--radius-md);
      font-size: var(--text-sm);
    }

    /* Table */
    .table-wrapper {
      overflow-x: auto;
      margin: var(--space-4) 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--text-sm);
    }

    th, td {
      padding: var(--space-3) var(--space-4);
      text-align: left;
      border-bottom: 1px solid var(--color-border);
    }

    th {
      background: var(--color-bg-secondary);
      font-weight: var(--font-semibold);
      color: var(--color-text);
      position: sticky;
      top: 0;
      z-index: 1;
    }

    td {
      color: var(--color-text-secondary);
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background: var(--color-bg-tertiary);
    }

    .food-name {
      font-weight: var(--font-medium);
      color: var(--color-text);
      white-space: nowrap;
    }

    .food-state {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      font-style: italic;
    }

    .protein-value {
      font-weight: var(--font-semibold);
      color: var(--color-primary);
      white-space: nowrap;
    }

    .serving-info {
      white-space: nowrap;
      color: var(--color-text-muted);
      font-size: var(--text-xs);
    }

    .source-info {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      max-width: 200px;
    }

    @media (max-width: 640px) {
      .source-info { display: none; }
      th:nth-child(5), td:nth-child(5) { display: none; }
    }

    /* Category sections */
    .category-section {
      margin-bottom: var(--space-10);
    }

    .category-section h3 {
      font-size: var(--text-lg);
      color: var(--color-primary);
      margin-bottom: var(--space-3);
      padding-bottom: var(--space-2);
      border-bottom: 1px solid var(--color-primary-light);
    }

    /* References */
    .references {
      font-size: var(--text-sm);
      line-height: 1.8;
      color: var(--color-text-secondary);
    }

    .references li {
      margin-bottom: var(--space-3);
    }

    .references cite {
      font-style: italic;
      color: var(--color-text);
    }

    .references a {
      color: var(--color-primary);
    }

    /* CTA */
    .article-cta {
      margin-top: var(--space-16);
      padding: var(--space-8);
      background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
      border-radius: var(--radius-xl);
      text-align: center;
      color: var(--color-text-inverse);
    }

    .article-cta h2 {
      color: var(--color-text-inverse);
      border-color: rgba(255,255,255,0.3);
      margin-bottom: var(--space-3);
    }

    .article-cta p {
      color: rgba(255,255,255,0.9);
      margin-bottom: var(--space-6);
    }

    .article-cta .btn {
      background: var(--color-text-inverse);
      color: var(--color-primary);
      border: none;
    }

    .article-cta .btn:hover {
      background: var(--color-bg-secondary);
      color: var(--color-primary-dark);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .article-header h1 { font-size: var(--text-3xl); }
      .article-section h2 { font-size: var(--text-xl); }
      .diet-tab { padding: var(--space-2) var(--space-4); }
    }
  </style>
</MainLayout>

<script>
  // Diet tab switching
  const tabs = document.querySelectorAll(".diet-tab");
  const panels = document.querySelectorAll(".diet-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const diet = tab.dataset.diet;
      
      tabs.forEach((t) => {
        t.setAttribute("aria-selected", "false");
      });
      panels.forEach((p) => {
        p.hidden = true;
      });
      
      tab.setAttribute("aria-selected", "true");
      document.getElementById("panel-" + diet).hidden = false;
    });
  });
</script>
