# FitTools - Environment Variables
# Copy this file to .env and fill in your values

# Site URL (used for sitemap, canonical URLs, OG tags)
SITE_URL=https://fittools.com.br

# Google Analytics 4
# Get from https://analytics.google.com/
# Format: G-XXXXXXXXXX
GA4_MEASUREMENT_ID=

# Google AdSense
# Get from https://www.google.com/adsense/
# Format: ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_CLIENT_ID=

# AdSense Ad Slot IDs (optional - create ad units in AdSense dashboard)
# ADSENSE_SLOT_HEADER=
# ADSENSE_SLOT_SIDEBAR=
# ADSENSE_SLOT_IN_ARTICLE=
# ADSENSE_SLOT_FOOTER=

# Google Search Console verification
# Get from https://search.google.com/search-console/
# GOOGLE_SITE_VERIFICATION=

# Formspree endpoint for contact form
# Get from https://formspree.io/
# FORMSPREE_ENDPOINT=

# Social media (used in JSON-LD and footer)
# INSTAGRAM_URL=https://instagram.com/fittools
# YOUTUBE_URL=https://youtube.com/@fittools
